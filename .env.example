# ============================================
# ABCH Ticketing System — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# For Coolify: paste these variables into the Environment tab.
# ============================================

# --- Database ---
POSTGRES_USER=johndoe
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=abch_db
# Docker internal URL (app → db service). Coolify auto-resolves service names.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=30&connect_timeout=10

# --- Redis ---
# Docker internal URL (app → redis service)
REDIS_URL=redis://redis:6379

# --- Auth Secrets — GENERATE NEW ONES FOR PRODUCTION ---
# Run: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_hex_64

# --- Web Push (VAPID Keys) ---
# Run: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_generate_new_vapid_keys
VAPID_PRIVATE_KEY=CHANGE_ME_generate_new_vapid_keys
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- App ---
PORT=3000
NODE_ENV=production
# Your public domain — used by CORS, CSP, and cookies
FRONTEND_URL=https://yourdomain.com

# --- Optional: MinIO / S3 Storage ---
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_BUCKET=hospital-tickets

# --- Optional: Rate Limits ---
# RATE_LIMIT_ANALYTICS=300
# RATE_LIMIT_SEARCH=60
# RATE_LIMIT_UPLOAD=100
