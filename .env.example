# Database Connection
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5434/abch_db?schema=public"

# Redis (for BullMQ and Rate Limiting)
REDIS_URL="redis://localhost:6380"

# Auth Secrets — ROTATE THESE IN PRODUCTION
JWT_ACCESS_SECRET="CHANGE_ME_USE_OPENSSL_RAND_HEX_64"
JWT_REFRESH_SECRET="CHANGE_ME_USE_OPENSSL_RAND_HEX_64"

# Web Push (VAPID Keys) — Generate new keys for production
VAPID_PUBLIC_KEY="CHANGE_ME_GENERATE_NEW_VAPID_KEYS"
VAPID_PRIVATE_KEY="CHANGE_ME_GENERATE_NEW_VAPID_KEYS"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# MinIO / S3 Storage
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET="hospital-tickets"

# App
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3001"
